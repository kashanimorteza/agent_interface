# Secrets owned by the Database layer.
#
# Copy this file to .env beside it and fill in the values. That file is never
# committed, never packaged, and never read by another layer.

# Key material for the reversible at-rest treatment. Generate one with:
#   uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Losing it makes every credential stored under that treatment unreadable.
TRADING_ASSISTANT_DATABASE_ENCRYPTION_KEY=

# Server-backed engines also need connection credentials, named per Instance:
#   TRADING_ASSISTANT_<INSTANCE>_DATABASE_USERNAME=
#   TRADING_ASSISTANT_<INSTANCE>_DATABASE_PASSWORD=
# The file-backed engine this project runs on needs neither.
