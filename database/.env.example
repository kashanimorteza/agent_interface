# Runtime configuration of the Database Component. Copy to .env (never committed) and fill in values.
# Process environment variables take precedence over this file.

# SQLAlchemy connection URL. Empty means the default: the sqlite URL of database/app.db.
DATABASE_URL=

# Fernet key for the reversible encryption of encrypted credential columns (accounts.password).
# Required before the first encrypted write, including the initial-data migration.
# Generate one with: uv run python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
CREDENTIAL_ENCRYPTION_KEY=
