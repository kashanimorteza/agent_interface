{
  "name": "presentation",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "The Presentation Component of the Trading Assistant.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "generate:api": "node --env-file-if-exists=.env.local scripts/generate-api.ts",
    "format": "prettier --write app presentation scripts",
    "format:check": "prettier --check app presentation scripts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "dependencies": {
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.0",
    "openapi-typescript": "7.13.0",
    "prettier": "3.9.10",
    "typescript": "5.9.3"
  }
}
