{
  "name": "presentation",
  "private": true,
  "version": "0.1.0",
  "description": "The Trading Assistant Presentation: one page for every Entity of Model, working with its records through API.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write --ignore-path ../.gitignore .",
    "format:check": "prettier --check --ignore-path ../.gitignore ."
  },
  "dependencies": {
    "@ant-design/icons": "6.3.4",
    "@fontsource/vazirmatn": "5.3.0",
    "@refinedev/antd": "6.0.3",
    "@refinedev/core": "5.0.12",
    "@refinedev/react-router": "2.0.4",
    "@tanstack/react-query": "5.104.2",
    "antd": "5.29.3",
    "dayjs": "1.11.23",
    "i18next": "26.4.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-i18next": "17.0.16",
    "react-router": "7.18.4",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vite": "8.3.4"
  }
