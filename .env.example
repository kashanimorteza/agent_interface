# Secret runtime values of the Trading Assistant.
#
# Copy this file to .env and fill in real values. The .env file is never
# committed. A value set in the process environment overrides the .env file.

# Key for the reversible at-rest mode of credential fields (the Account
# password). Generate one with:  uv run python -m my_database generate-key
TRADING_ASSISTANT_DATABASE_ENCRYPTION_KEY=<generate-with-my_database-generate-key>

# Connection credentials of the "general" Database Instance. A file-backed
# Engine needs none; a server Engine reads them from here.
TRADING_ASSISTANT_GENERAL_DATABASE_USERNAME=<username-or-empty>
TRADING_ASSISTANT_GENERAL_DATABASE_PASSWORD=<password-or-empty>
