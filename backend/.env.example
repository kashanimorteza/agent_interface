# Runtime configuration of the Backend Component. Copy to .env (never committed) and fill in values.
# Process environment variables take precedence over this file.

# Bind address of the HTTP API server. Default: 127.0.0.1
BACKEND_HOST=

# Port of the HTTP API server. Default: 8000
BACKEND_PORT=

# Comma-separated browser origins allowed to call the API. Default: http://127.0.0.1:3000,http://localhost:3000
BACKEND_CORS_ORIGINS=

# DATABASE_URL and CREDENTIAL_ENCRYPTION_KEY are read by the Database package from database/.env
# (or from the process environment) and are not set here.
